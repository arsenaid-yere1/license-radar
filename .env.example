NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Server-only SMS configuration. Live enrollment defaults off.
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
SMS_WEBHOOK_URL=
SMS_SENDER_ALLOWLIST=
SMS_SUPPORT_EMAIL=
SMS_LIVE_ENABLED=false
SMS_TERMS_REVIEWED=
# Local provider fixtures are configured only by the guarded prepare tool.
# Email reminders are primary and independently default off.
EMAIL_REMINDERS_ENABLED=false
# Unset defaults to resend; gmail uses a separate private OAuth configuration.
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_NAMESPACE=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
REMINDER_WORKER_SECRET=
REMINDER_APP_URL=
# Single-account Gmail pilot; sender, reply-to and allowed recipient must match.
GMAIL_PROVIDER_NAMESPACE=
GMAIL_SENDER_EMAIL=
GMAIL_REPLY_TO=
GMAIL_ALLOWED_RECIPIENT=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_OAUTH_BINDING=
# Private renewal evidence is independent of reminder sending.
RENEWAL_EVIDENCE_ENABLED=false
EVIDENCE_CLEANUP_SECRET=

# Independent completion monitor: production-only, no local or preview pings.
REMINDER_HEALTHCHECK_ENABLED=false
# Protected server Secret; never use a NEXT_PUBLIC setting for this URL.
REMINDER_HEALTHCHECK_URL=
